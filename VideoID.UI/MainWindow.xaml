<Window x:Class="VideoID.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:VideoID.UI.ViewModels"
        xmlns:conv="clr-namespace:VideoID.UI.Converters"
        mc:Ignorable="d"
        Title="VideoID — GPU Face Identification"
        Width="1280" Height="800"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <conv:ByteArrayToImageConverter x:Key="BytesToImage" />
        <conv:BoolToColorConverter      x:Key="BoolToColor" />
        <conv:InverseBoolConverter      x:Key="InverseBool" />
        <BooleanToVisibilityConverter   x:Key="BoolToVis" />
        <conv:InverseBoolToVisConverter x:Key="InverseBoolToVis" />
        <conv:StateToColorConverter     x:Key="StateToColor" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />   <!-- Header toolbar -->
            <RowDefinition Height="*" />    <!-- Main content -->
            <RowDefinition Height="36" />   <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ══ Header toolbar ══════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{StaticResource BackgroundDarkestBrush}"
                BorderBrush="{StaticResource BackgroundHighlightBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Logo / title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="VideoID" FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource AccentBlueBrush}" />
                    <TextBlock Text=" GPU Face Identification" FontSize="14"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Bottom" Margin="4,0,0,2" />
                </StackPanel>

                <!-- Tab switcher -->
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <RadioButton Content="Faces" GroupName="tabs" IsChecked="True"
                                 Style="{StaticResource TabButton}"
                                 Command="{Binding SetTabCommand}"
                                 CommandParameter="Faces" />
                    <RadioButton Content="Videos" GroupName="tabs"
                                 Style="{StaticResource TabButton}"
                                 Command="{Binding SetTabCommand}"
                                 CommandParameter="Videos" />
                    <RadioButton Content="Settings" GroupName="tabs"
                                 Style="{StaticResource TabButton}"
                                 Command="{Binding SetTabCommand}"
                                 CommandParameter="Settings" />
                </StackPanel>

                <!-- Action buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="0,0,4,0">

                    <Border Width="10" Height="10" CornerRadius="5" Margin="0,0,6,0"
                            VerticalAlignment="Center">
                        <Border.Background>
                            <Binding Path="GpuAvailable" Converter="{StaticResource BoolToColor}" />
                        </Border.Background>
                        <Border.ToolTip>
                            <ToolTip>
                                <TextBlock>
                                    <Run Text="GPU:" />
                                    <Run Text="{Binding GpuAvailable, StringFormat={}{0}}" />
                                </TextBlock>
                            </ToolTip>
                        </Border.ToolTip>
                    </Border>

                    <Button Content="Add Videos"
                            Style="{StaticResource GhostButton}"
                            Margin="4,0"
                            Command="{Binding AddVideoDirectoryCommand}"
                            IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBool}}" />

                    <Button Content="▶  Start Scan"
                            Style="{StaticResource PrimaryButton}"
                            Margin="4,0"
                            Command="{Binding StartScanCommand}" />

                    <Button Content="■  Stop"
                            Style="{StaticResource DangerButton}"
                            Margin="4,0"
                            Command="{Binding StopScanCommand}" />

                    <Button Content="Export"
                            Style="{StaticResource GhostButton}"
                            Margin="4,0"
                            Command="{Binding ExportNamesCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ Main content (tab pages) ═══════════════════════════════════ -->
        <Grid Grid.Row="1">

            <!-- ── FACES TAB ─────────────────────────────────────────────── -->
            <Grid Visibility="{Binding IsFacesTab, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Filter / summary bar -->
                <Border Grid.Row="0"
                        Background="{StaticResource BackgroundDarkBrush}"
                        Padding="16,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource SectionHeader}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,16,0">
                                <Run Text="{Binding UniqueFacesCount}" />
                                <Run Text=" unique face(s)" />
                            </TextBlock>

                            <TextBox x:Name="SearchBox"
                                     Width="200" Margin="0,0,8,0"
                                     Tag="Filter faces…"
                                     Text="{Binding FaceFilter, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Clear All"
                                    Style="{StaticResource DangerButton}"
                                    Padding="10,6"
                                    Command="{Binding ClearIdentitiesCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Face cards grid -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding FilteredIdentities}"
                                  Margin="8">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:FaceIdentityViewModel}">
                                <Border Style="{StaticResource Card}" Width="172">
                                    <StackPanel>
                                        <!-- Face thumbnail -->
                                        <Border CornerRadius="6" ClipToBounds="True"
                                                Width="148" Height="148"
                                                Margin="0,0,0,8"
                                                Background="{StaticResource BackgroundLightBrush}">
                                            <Grid>
                                                <!-- Placeholder when no thumbnail -->
                                                <TextBlock Text="?" FontSize="40"
                                                           Foreground="{StaticResource TextDisabledBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Visibility="{Binding HasThumbnail,
                                                               Converter={StaticResource InverseBoolToVis}}" />
                                                <Image Source="{Binding Thumbnail}"
                                                       Stretch="UniformToFill" />
                                            </Grid>
                                        </Border>

                                        <!-- Name display / edit -->
                                        <Grid>
                                            <!-- View mode -->
                                            <StackPanel Visibility="{Binding IsEditing,
                                                            Converter={StaticResource InverseBoolToVis}}">
                                                <TextBlock Text="{Binding Name}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,0,0,4" />
                                                <TextBlock HorizontalAlignment="Center"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           FontSize="11">
                                                    <Run Text="{Binding FaceCount}" />
                                                    <Run Text=" detect ·" />
                                                    <Run Text="{Binding VideoCount}" />
                                                    <Run Text=" video(s)" />
                                                </TextBlock>
                                                <Button Content="Name this face"
                                                        Style="{StaticResource GhostButton}"
                                                        Margin="0,8,0,0"
                                                        Padding="8,4"
                                                        FontSize="11"
                                                        HorizontalAlignment="Center"
                                                        Command="{Binding BeginEditCommand}" />
                                            </StackPanel>

                                            <!-- Edit mode -->
                                            <StackPanel Visibility="{Binding IsEditing,
                                                            Converter={StaticResource BoolToVis}}">
                                                <TextBox Text="{Binding EditName,
                                                             UpdateSourceTrigger=PropertyChanged}"
                                                         HorizontalAlignment="Stretch"
                                                         Margin="0,0,0,6">
                                                    <TextBox.InputBindings>
                                                        <KeyBinding Key="Return"
                                                                    Command="{Binding CommitNameCommand}" />
                                                        <KeyBinding Key="Escape"
                                                                    Command="{Binding CancelEditCommand}" />
                                                    </TextBox.InputBindings>
                                                </TextBox>
                                                <StackPanel Orientation="Horizontal"
                                                            HorizontalAlignment="Center">
                                                    <Button Content="✓"
                                                            Style="{StaticResource PrimaryButton}"
                                                            Padding="10,4" Margin="0,0,4,0"
                                                            Command="{Binding CommitNameCommand}" />
                                                    <Button Content="✕"
                                                            Style="{StaticResource DangerButton}"
                                                            Padding="10,4"
                                                            Command="{Binding CancelEditCommand}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Empty state -->
                <StackPanel Grid.Row="1"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding HasNoIdentities, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="No faces found yet"
                               FontSize="22" FontWeight="Light"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Add video directories and press Start Scan"
                               FontSize="14"
                               Foreground="{StaticResource TextDisabledBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0" />
                </StackPanel>
            </Grid>

            <!-- ── VIDEOS TAB ─────────────────────────────────────────────── -->
            <Grid Visibility="{Binding IsVideosTab, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource BackgroundDarkBrush}" Padding="16,8">
                    <TextBlock Style="{StaticResource SectionHeader}">
                        <Run Text="{Binding Videos.Count}" />
                        <Run Text=" video file(s) ·" />
                        <Run Text="{Binding TotalFramesProcessed}" />
                        <Run Text=" frames processed ·" />
                        <Run Text="{Binding TotalFacesFound}" />
                        <Run Text=" face detections" />
                    </TextBlock>
                </Border>

                <ListView Grid.Row="1"
                          ItemsSource="{Binding Videos}"
                          Background="{StaticResource BackgroundMidBrush}"
                          BorderThickness="0"
                          Foreground="{StaticResource TextPrimaryBrush}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="File" Width="300"
                                            DisplayMemberBinding="{Binding FileName}" />
                            <GridViewColumn Header="Duration" Width="80"
                                            DisplayMemberBinding="{Binding Duration,
                                                StringFormat={}{0:hh\\:mm\\:ss}}" />
                            <GridViewColumn Header="Size" Width="80"
                                            DisplayMemberBinding="{Binding FileSizeText}" />
                            <GridViewColumn Header="Frames" Width="80"
                                            DisplayMemberBinding="{Binding TotalFrames}" />
                            <GridViewColumn Header="Faces" Width="60"
                                            DisplayMemberBinding="{Binding FacesFound}" />
                            <GridViewColumn Header="Status" Width="100">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="8" Height="8" CornerRadius="4"
                                                    Margin="0,0,6,0" VerticalAlignment="Center"
                                                    Background="{Binding State,
                                                        Converter={StaticResource StateToColor}}" />
                                            <TextBlock Text="{Binding StateText}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Progress" Width="160">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <ProgressBar Value="{Binding ProgressPercent}"
                                                     Maximum="100" Width="140" Height="6" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>

            <!-- ── SETTINGS TAB ───────────────────────────────────────────── -->
            <ScrollViewer Visibility="{Binding IsSettingsTab, Converter={StaticResource BoolToVis}}"
                          VerticalScrollBarVisibility="Auto">
                <Border MaxWidth="700" HorizontalAlignment="Center" Margin="24">
                    <StackPanel>

                        <TextBlock Text="Processing" Style="{StaticResource SectionHeader}" />
                        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="240" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Text="Frame skip (1 = every frame)"
                                           VerticalAlignment="Center" Margin="0,6" />
                                <TextBox Grid.Row="0" Grid.Column="1" Margin="8,6,0,6"
                                         Text="{Binding Settings.FrameSkip,
                                             UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="1" Grid.Column="0"
                                           Text="Parallel video threads"
                                           VerticalAlignment="Center" Margin="0,6" />
                                <TextBox Grid.Row="1" Grid.Column="1" Margin="8,6,0,6"
                                         Text="{Binding Settings.MaxParallelVideos,
                                             UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="2" Grid.Column="0"
                                           Text="GPU detector workers"
                                           VerticalAlignment="Center" Margin="0,6" />
                                <TextBox Grid.Row="2" Grid.Column="1" Margin="8,6,0,6"
                                         Text="{Binding Settings.GpuWorkers,
                                             UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="3" Grid.Column="0"
                                           Text="Detection scale (0.1–1.0)"
                                           VerticalAlignment="Center" Margin="0,6" />
                                <TextBox Grid.Row="3" Grid.Column="1" Margin="8,6,0,6"
                                         Text="{Binding Settings.DetectionScale,
                                             UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="4" Grid.Column="0"
                                           Text="Detection confidence threshold"
                                           VerticalAlignment="Center" Margin="0,6" />
                                <TextBox Grid.Row="4" Grid.Column="1" Margin="8,6,0,6"
                                         Text="{Binding Settings.DetectionConfidence,
                                             UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="5" Grid.Column="0"
                                           Text="Face match threshold (cosine)"
                                           VerticalAlignment="Center" Margin="0,6" />
                                <TextBox Grid.Row="5" Grid.Column="1" Margin="8,6,0,6"
                                         Text="{Binding Settings.FaceMatchThreshold,
                                             UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </Border>

                        <TextBlock Text="GPU / Hardware" Style="{StaticResource SectionHeader}" />
                        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                            <StackPanel>
                                <CheckBox Content="Use CUDA GPU acceleration"
                                          Foreground="{StaticResource TextPrimaryBrush}"
                                          IsChecked="{Binding Settings.UseGpu}"
                                          Margin="0,4" />
                                <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="11" Margin="0,4,0,0">
                                    <Run Text="CUDA status: " />
                                    <Run Text="{Binding GpuAvailable, StringFormat={}{0}}"
                                         Foreground="{Binding GpuAvailable,
                                             Converter={StaticResource BoolToColor}}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Models" Style="{StaticResource SectionHeader}" />
                        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding Settings.ModelDirectory,
                                             UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1" Content="Browse"
                                        Style="{StaticResource GhostButton}"
                                        Margin="8,0,0,0"
                                        Command="{Binding Settings.BrowseModelDirectoryCommand}" />
                            </Grid>
                        </Border>

                        <TextBlock Text="Output" Style="{StaticResource SectionHeader}" />
                        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                            <StackPanel>
                                <CheckBox Content="Write face names as video metadata tags (ID3 / MP4 atoms)"
                                          Foreground="{StaticResource TextPrimaryBrush}"
                                          IsChecked="{Binding Settings.WriteTagsToFiles}"
                                          Margin="0,4" />
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Database path" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Margin="8,0,0,0"
                                             Text="{Binding Settings.DatabasePath,
                                                 UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Video Directories" Style="{StaticResource SectionHeader}" />
                        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="One directory per line:"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="11" Margin="0,0,0,6" />
                                <TextBox AcceptsReturn="True" Height="100"
                                         VerticalScrollBarVisibility="Auto"
                                         Text="{Binding Settings.VideoDirectoriesText,
                                             UpdateSourceTrigger=PropertyChanged}" />
                                <Button Content="+ Add Directory"
                                        Style="{StaticResource GhostButton}"
                                        Margin="0,8,0,0"
                                        HorizontalAlignment="Left"
                                        Command="{Binding Settings.AddVideoDirectoryCommand}" />
                            </StackPanel>
                        </Border>

                        <Button Content="Apply Settings"
                                Style="{StaticResource PrimaryButton}"
                                Padding="24,10"
                                HorizontalAlignment="Right"
                                Command="{Binding Settings.ApplyCommand}" />
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>

        <!-- ══ Status bar ══════════════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Background="{StaticResource BackgroundDarkestBrush}"
                BorderBrush="{StaticResource BackgroundHighlightBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusText}"
                           Style="{StaticResource StatusText}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Style="{StaticResource StatusText}" Margin="0,0,16,0">
                        <Run Text="Unique faces: " />
                        <Run Text="{Binding UniqueFacesCount}"
                             Foreground="{StaticResource AccentBlueBrush}" />
                    </TextBlock>
                    <ProgressBar Width="120" Height="4"
                                 IsIndeterminate="{Binding IsProcessing}"
                                 VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
