<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Background palette (dark theme) -->
    <Color x:Key="BackgroundDarkest">#FF0D0D0D</Color>
    <Color x:Key="BackgroundDark">#FF1A1A1A</Color>
    <Color x:Key="BackgroundMid">#FF252525</Color>
    <Color x:Key="BackgroundLight">#FF303030</Color>
    <Color x:Key="BackgroundHighlight">#FF3A3A3A</Color>

    <!-- Accent -->
    <Color x:Key="AccentBlue">#FF2196F3</Color>
    <Color x:Key="AccentBlueDark">#FF1565C0</Color>
    <Color x:Key="AccentGreen">#FF4CAF50</Color>
    <Color x:Key="AccentOrange">#FFFF9800</Color>
    <Color x:Key="AccentRed">#FFF44336</Color>

    <!-- Text -->
    <Color x:Key="TextPrimary">#FFFAFAFA</Color>
    <Color x:Key="TextSecondary">#FFB0BEC5</Color>
    <Color x:Key="TextDisabled">#FF607D8B</Color>

    <SolidColorBrush x:Key="BackgroundDarkestBrush"  Color="{StaticResource BackgroundDarkest}" />
    <SolidColorBrush x:Key="BackgroundDarkBrush"     Color="{StaticResource BackgroundDark}" />
    <SolidColorBrush x:Key="BackgroundMidBrush"      Color="{StaticResource BackgroundMid}" />
    <SolidColorBrush x:Key="BackgroundLightBrush"    Color="{StaticResource BackgroundLight}" />
    <SolidColorBrush x:Key="BackgroundHighlightBrush" Color="{StaticResource BackgroundHighlight}" />
    <SolidColorBrush x:Key="AccentBlueBrush"         Color="{StaticResource AccentBlue}" />
    <SolidColorBrush x:Key="AccentBlueDarkBrush"     Color="{StaticResource AccentBlueDark}" />
    <SolidColorBrush x:Key="AccentGreenBrush"        Color="{StaticResource AccentGreen}" />
    <SolidColorBrush x:Key="AccentOrangeBrush"       Color="{StaticResource AccentOrange}" />
    <SolidColorBrush x:Key="AccentRedBrush"          Color="{StaticResource AccentRed}" />
    <SolidColorBrush x:Key="TextPrimaryBrush"        Color="{StaticResource TextPrimary}" />
    <SolidColorBrush x:Key="TextSecondaryBrush"      Color="{StaticResource TextSecondary}" />
    <SolidColorBrush x:Key="TextDisabledBrush"       Color="{StaticResource TextDisabled}" />

</ResourceDictionary>
